<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>SkiaSharp.Extended.Drawing.Common</AssemblyName>
    <RootNamespace>System.Drawing</RootNamespace>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyVersion>10.0.0.0</AssemblyVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>CS1591;CS0109;CS0219;CS0414;CS0436;CS0618;CS0649;CS0672;CS1690;CS3021;CS8602;CS8604;CS8618;SYSLIB0051</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SkiaSharp.Extended.Drawing.Common</PackageId>
    <Title>SkiaSharp.Extended.Drawing.Common</Title>
    <Description>SkiaSharp-backed drop-in replacement for System.Drawing.Common. Provides the same API surface backed by SkiaSharp for cross-platform rendering.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SkiaSharp.Extended.Drawing.Common.Tests" />
  </ItemGroup>

</Project>
